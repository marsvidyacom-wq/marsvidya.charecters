# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=
# Base64-encoded Supabase database root certificate from Database Settings > SSL Configuration
DATABASE_SSL_CA_BASE64=

# Auth.js and Google OAuth
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# AI, speech-to-text, and text-to-speech
# The voice routes use this server-only Sarvam subscription key.
SARVAM_API=
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
STT_PROVIDER=openai
STT_API_KEY=
STT_MODEL=gpt-4o-mini-transcribe
TTS_PROVIDER=openai
TTS_API_KEY=
TTS_MODEL=gpt-4o-mini-tts

# Optional Cloudflare R2 storage
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Optional Razorpay billing
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional distributed rate limiting (not required for V1 local development)
REDIS_URL=
